# Copy to .env.local for local development, and add the same variable in
# Vercel under Project Settings -> Environment Variables.
#
# Neon Postgres connection string.
# Use the POOLED endpoint (hostname contains "-pooler") — serverless functions
# open many short-lived connections, and the pooler is what keeps that fast.
# Grab it from the Neon dashboard: Project -> Connection Details -> "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
